# ============================================
# WESApp Frontend - Production Environment
# ============================================
# IMPORTANT: Copy this file to .env.production
# ============================================

# API URL - Point to your production backend
# Examples:
#   http://localhost:3000/api              (local testing)
#   https://api.wesecurity.com/api         (production)
#   https://wesapp-backend.herokuapp.com/api

REACT_APP_API_URL=http://localhost:3000/api

# ============================================
# OPTIONAL: Feature flags
# ============================================
# REACT_APP_ENABLE_DARK_MODE=false
# REACT_APP_ENABLE_NOTIFICATIONS=true
# REACT_APP_DEBUG_MODE=false

# ============================================
# NOTES
# ============================================
# 1. This file is used when running: npm run build
#
# 2. Update REACT_APP_API_URL to point to your backend
#
# 3. For Electron app, the API URL should point to
#    wherever your backend is hosted
#
# 4. Environment variables must start with REACT_APP_
#    to be accessible in React
# ============================================
