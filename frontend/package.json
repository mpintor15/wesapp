{
  "name": "wesapp-frontend",
  "version": "1.0.0",
  "description": "Frontend React para WESApp - WES Security",
  "author": "WES Security",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/check-production-bundle.js",
    "check:production-bundle": "node scripts/check-production-bundle.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:unit": "react-scripts test --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test e2e/auth.setup.js --project=setup",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.js --project=chromium",
    "test:responsive": "npm run test:responsive:chromium && npm run test:responsive:webkit",
    "test:responsive:chromium": "playwright test e2e/responsive-chromium.spec.js --project=chromium",
    "test:responsive:webkit": "playwright test e2e/responsive-webkit.spec.js --project=webkit",
    "test:visual": "playwright test e2e/visual-pages.spec.js e2e/visual-modals.spec.js",
    "test:visual:chromium": "playwright test e2e/visual-pages.spec.js e2e/visual-modals.spec.js --project=chromium --workers=1",
    "test:visual:webkit": "playwright test e2e/visual-pages.spec.js e2e/visual-modals.spec.js --project=webkit --workers=1",
    "test:visual:update": "E2E_ASSERT_SNAPSHOTS=1 playwright test e2e/visual-pages.spec.js e2e/visual-modals.spec.js --update-snapshots"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.8.4",
    "react-scripts": "5.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
