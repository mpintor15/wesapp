# Backend Environment Configuration
# Copy this file to .env.development and .env.production with your actual values

# Server
PORT=3001

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wesapp
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false

# JWT Configuration
JWT_SECRET=change_this_secret
JWT_EXPIRATION=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Environment
NODE_ENV=development

# Local Playwright E2E only. Raises development rate-limit buckets.
# Ignored automatically when NODE_ENV=production.
E2E_MODE=false
