# ============================================
# WESApp - Production Environment Variables
# ============================================
# IMPORTANT: Copy this file to .env and fill in the values
# DO NOT commit .env to git (it's in .gitignore)
# ============================================

# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# DATABASE
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wesapp
DB_USER=wesapp_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Pool de conexiones (ajustar según carga)
DB_POOL_MAX=30
DB_POOL_MIN=5

# ============================================
# SECURITY
# ============================================
# CRITICAL: Generate a strong secret for JWT
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_RANDOM_32_BYTE_HEX_STRING

# JWT token expiration (24h, 7d, 30d, etc.)
JWT_EXPIRATION=24h

# ============================================
# CORS
# ============================================
# IMPORTANT: Set to your frontend domain in production
# Examples:
#   https://app.wesecurity.com
#   https://wesapp.yourdomain.com
# DO NOT use * in production!
CORS_ORIGIN=http://localhost:3001

# ============================================
# LOGGING
# ============================================
# Logging level: error, warn, info, debug
LOG_LEVEL=info

# ============================================
# OPTIONAL: Email (for future notifications)
# ============================================
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# ============================================
# OPTIONAL: File uploads
# ============================================
# MAX_FILE_SIZE=10485760  # 10MB in bytes
# UPLOAD_DIR=./uploads

# ============================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================
# 1. Generate strong JWT_SECRET:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 2. Create strong database password:
#    - Minimum 16 characters
#    - Mix of uppercase, lowercase, numbers, symbols
#
# 3. Update CORS_ORIGIN to your actual domain
#
# 4. If using PM2, these vars will be loaded automatically
#
# 5. Keep this file secure - never commit to git
# ============================================
