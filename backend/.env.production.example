# ============================================================
# WESApp — Variables de entorno para producción (Railway)
# ============================================================
# Copia este archivo, renómbralo a .env y llena los valores.
# NUNCA subas el .env real a git (está en .gitignore).
# En Railway, configura estas variables en el dashboard.
# ============================================================

# ─── SERVIDOR ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── BASE DE DATOS (Neon serverless PostgreSQL) ─────────────
# Obtén estos valores desde: https://console.neon.tech
# En tu proyecto Neon: Connection Details → parámetros individuales
#
# Ejemplo de host: ep-dawn-thunder-123456.us-east-2.aws.neon.tech
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=wesapp
DB_USER=wesapp_owner
DB_PASSWORD=xxxxxxxxxxxxxxxxxx
DB_SSL=true

# Pool de conexiones (ajustar según plan de Neon)
DB_POOL_MAX=10
DB_POOL_MIN=2

# ─── SEGURIDAD ───────────────────────────────────────────────
# Genera un secreto fuerte con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRATION=24h

# ─── CORS ────────────────────────────────────────────────────
# En monolito (frontend + backend en mismo servicio), el origen
# es el mismo dominio. Ajustar al subdominio final de WES Security.
CORS_ORIGIN=https://app.wessecurity.com
