{
  "name": "wesapp-backend",
  "version": "1.0.0",
  "description": "Backend API para WESApp - WES Security",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('./src/config/migrations').runMigrations().then(() => require('./src/config/database').close()).catch((error) => { console.error(error); process.exit(1); })\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "storage",
      "logs",
      "*.pdf",
      "*.xlsx"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "readdir-glob": {
      "minimatch": {
        ".": "5.1.8",
        "brace-expansion": "2.0.3"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.8.4",
    "supertest": "^6.3.4",
    "typescript": "^6.0.3"
  }
}
